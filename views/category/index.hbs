<div>
	<div class='d-flex justify-content-between gap-2'>
		<a href='/' class='btn btn-outline-dark fw-semibold'>
			<i class='bi bi-arrow-left'></i>
			Go back
		</a>

		<a href='/categories/create' class='btn btn-outline-dark fw-semibold px-5'>
			<i class='bi bi-plus-lg'></i>
			New category
		</a>
	</div>

	<div class='card shadow-sm border-0 mt-3'>
		<div class='card-header bg-dark text-white'>
			<h2 class='fs-4 m-0'>
				<i class='bi bi-tags'></i>
				Categories
			</h2>
		</div>

		<div class='card-body p-0'>
			{{#if hasCategories}}
				<div class='list-group list-group-flush'>
					{{#each categoryList}}
						<div class='list-group-item py-3'>
							<div class='d-flex justify-content-between align-items-start'>
								<div class='flex-grow-1'>
									<h5 class='mb-1 fw-semibold'>{{this.name}}</h5>
									<p class='text-secondary mb-0'>{{this.description}}</p>

									<p class='m-0 mt-2'>
										<strong>{{this.booksCount}}</strong>
										{{#if (eq this.booksCount 1)}}associated book{{else}}associated
											books{{/if}}
									</p>
								</div>
								<div class='ms-4 d-flex align-items-center gap-2'>
									<a
										href='/categories/edit/{{this.id}}'
										class='btn btn-sm btn-outline-primary'
									>
										<i class='bi bi-pencil'></i>
										Edit
									</a>

									<a
										href='/categories/delete/{{this.id}}'
										class='btn btn-sm btn-outline-danger'
									>
										<i class='bi bi-trash'></i>
										Delete
									</a>
								</div>
							</div>
						</div>
					{{/each}}
				</div>
			{{else}}
				<div class='text-center py-5'>
					<i class='bi bi-tags fs-1 text-secondary'></i>
					<p class='mt-3 mb-0 text-secondary'>No categories have been added.</p>
				</div>
			{{/if}}
		</div>
	</div>
</div>