<div>
	<div class='d-flex justify-content-between gap-2'>
		<a href='/' class='btn btn-outline-dark fw-semibold'>
			<i class='bi bi-arrow-left'></i>
			Go back
		</a>

		<a href='/books/create' class='btn btn-outline-dark fw-semibold px-5'>
			<i class='bi bi-plus-lg'></i>
			New book
		</a>
	</div>

	<div class='card shadow-sm border-0 mt-3'>
		<div class='card-header bg-dark text-white'>
			<h2 class='fs-4 m-0'>
				<i class='bi bi-book'></i>
				Books
			</h2>
		</div>

		<div class='card-body p-0'>
			{{#if hasBooks}}
				<div class='list-group list-group-flush'>
					{{#each bookList}}
						<div class='list-group-item py-3'>
							<div class='d-flex justify-content-between align-items-start'>
								<div class='d-flex gap-3 flex-grow-1'>
									{{#if this.coverUrl}}
										<img
											src='{{this.coverUrl}}'
											alt='Cover of {{this.title}}'
											class='book-cover-thumb'
										/>
									{{else}}
										<div
											class='book-cover-placeholder bg-light d-flex align-items-center justify-content-center'
										>
											<i class='bi bi-image fs-3 text-secondary'></i>
										</div>
									{{/if}}

									<div>
										<h5 class='mb-1 fw-semibold'>
											{{this.title}}
											<span
												class='badge text-bg-secondary ms-2'
											>{{this.year}}</span>
										</h5>
										<p class='text-secondary mb-0'>
											<i class='bi bi-tag'></i>
											{{this.Category.name}}
										</p>
										<p class='text-secondary mb-0'>
											<i class='bi bi-person'></i>
											{{this.Author.name}}
										</p>
										<p class='text-secondary mb-0'>
											<i class='bi bi-building'></i>
											{{this.Publisher.name}}
										</p>
									</div>
								</div>
								<div class='ms-4 d-flex align-items-center gap-2'>
									<a
										href='/books/edit/{{this.id}}'
										class='btn btn-sm btn-outline-primary'
									>
										<i class='bi bi-pencil'></i>
										Edit
									</a>

									<a
										href='/books/delete/{{this.id}}'
										class='btn btn-sm btn-outline-danger'
									>
										<i class='bi bi-trash'></i>
										Delete
									</a>
								</div>
							</div>
						</div>
					{{/each}}
				</div>
			{{else}}
				<div class='text-center py-5'>
					<i class='bi bi-book fs-1 text-secondary'></i>
					<p class='mt-3 mb-0 text-secondary'>No books have been added.</p>
				</div>
			{{/if}}
		</div>
	</div>
</div>