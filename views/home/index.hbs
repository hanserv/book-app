<div class='card shadow-sm border-0'>
	<div class='card-header bg-dark text-white'>
		<h2 class='fs-5 m-0'>
			<i class='bi bi-search'></i> Search books
		</h2>
	</div>

	<div class='card-body bg-white p-3'>
		<form method='get' action='/'>
			<div class='mb-2'>
				<label for='title' class='form-label fw-semibold'>Title:</label>
				<input type='text' class='form-control' id='title' name='title' value='{{title}}' placeholder='Search by title' />
			</div>

			{{#if hasCategories}}
				<div class='mb-2'>
					<span class='form-label fw-semibold d-block'>Categories:</span>
					<div class='d-flex flex-wrap gap-3'>
						{{#each categoryList}}
							<div class='form-check'>
								<input
									class='form-check-input'
									type='checkbox'
									id='category-{{this.id}}'
									name='categoryId'
									value='{{this.id}}'
									{{#if this.isSelected}}checked{{/if}}
								/>
								<label class='form-check-label' for='category-{{this.id}}'>{{this.name}}</label>
							</div>
						{{/each}}
					</div>
				</div>
			{{/if}}

			<div class='mt-3 d-flex justify-content-end gap-2'>
				<a href='/' class='btn btn-outline-dark'>
					<i class='bi bi-x-lg'></i> Clear
				</a>

				<button type='submit' class='btn btn-dark px-4'>
					<i class='bi bi-funnel'></i> Filter
				</button>
			</div>
		</form>
	</div>
</div>

<div class='mt-3'>
	{{#if hasBooks}}
		<div class='row g-3'>
			{{#each bookList}}
				<div class='col-12 col-sm-6 col-lg-3'>
					<a href='/books/detail/{{this.id}}' class='text-decoration-none text-reset'>
						<div class='card book-card h-100 shadow-sm border-0'>
							{{#if this.coverUrl}}
								<img src='{{this.coverUrl}}' alt='Cover of {{this.title}}' class='card-img-top book-card-cover' />
							{{else}}
								<div class='book-card-placeholder bg-light d-flex align-items-center justify-content-center'>
									<i class='bi bi-image fs-1 text-secondary'></i>
								</div>
							{{/if}}

							<div class='card-body'>
								<h5 class='card-title fw-semibold mb-1'>{{this.title}}</h5>
								<p class='mb-2'>
									<span class='badge text-bg-secondary'>{{this.year}}</span>
									<span class='badge text-bg-dark'>{{this.Category.name}}</span>
								</p>
								<p class='text-secondary small mb-0'>
									<i class='bi bi-person'></i> {{this.Author.name}}
								</p>
								<p class='text-secondary small mb-0'>
									<i class='bi bi-building'></i> {{this.Publisher.name}}
								</p>
							</div>
						</div>
					</a>
				</div>
			{{/each}}
		</div>
	{{else}}
		<div class='card shadow-sm border-0'>
			<div class='card-body text-center py-5'>
				<i class='bi bi-book fs-1 text-secondary'></i>
				{{#if hasFilters}}
					<p class='mt-3 mb-0 text-secondary'>No books match your search.</p>
				{{else}}
					<p class='mt-3 mb-0 text-secondary'>No books have been added yet.</p>
				{{/if}}
			</div>
		</div>
	{{/if}}
</div>