<!doctype html>
<html lang='en'>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1.0' />
		<link rel='stylesheet' href='/assets/css/lib/bootstrap/bootstrap.min.css' />
		<link rel='stylesheet' href='https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css'/>
		<link rel='stylesheet' href='/assets/css/site/main.css' />
		<title>{{pageTitle}} | BookApp</title>
	</head>
	<body>
		<header class="mx-2">
			<nav class='navbar navbar-expand-lg navbar-dark bg-black rounded-5 shadow container mt-3 mb-3 px-4 py-2'>
				<div class='container-fluid p-0'>
					<a href='/' class='navbar-brand fs-4 fw-semibold  text-white m-0'>
						<i class='bi bi-book'></i> BookApp
					</a>

					<button
						class='navbar-toggler'
						type='button'
						data-bs-toggle='collapse'
						data-bs-target='#mainNavbar'
						aria-controls='mainNavbar'
						aria-expanded='false'
						aria-label='Toggle navigation'
					>
						<span class='navbar-toggler-icon'></span>
					</button>

					<div class='collapse navbar-collapse' id='mainNavbar'>
						<ul class='navbar-nav ms-auto gap-2 gap-lg-4 text-center text-lg-start'>
							<li class='nav-item'>
								<a class='nav-link px-0 rounded-0 border-bottom border-2 {{#if (isActive currentPath "home")}}active fw-semibold border-white{{else}}border-black{{/if}}' href='/'>Home</a>
							</li>
							<li class='nav-item'>
								<a class='nav-link px-0 rounded-0 border-bottom border-2 {{#if (isActive currentPath "books")}}active fw-semibold border-white{{else}}border-black{{/if}}' href='/books/index'>Books</a>
							</li>
							<li class='nav-item'>
								<a class='nav-link px-0 rounded-0 border-bottom border-2 {{#if (isActive currentPath "categories")}}active fw-semibold border-white{{else}}border-black{{/if}}' href='/categories/index'>Categories</a>
							</li>
							<li class='nav-item'>
								<a class='nav-link px-0 rounded-0 border-bottom border-2 {{#if (isActive currentPath "authors")}}active fw-semibold border-white{{else}}border-black{{/if}}' href='/authors/index'>Authors</a>
							</li>
							<li class='nav-item'>
								<a class='nav-link px-0 rounded-0 border-bottom border-2 {{#if (isActive currentPath "publishers")}}active fw-semibold border-white{{else}}border-black{{/if}}' href='/publishers/index'>Publishers</a>
							</li>
						</ul>
					</div>
				</div>
			</nav>
		</header>

		<main class='container mt-3 mb-5'>
			{{{body}}}
		</main>

		<script src='/assets/js/lib/bootstrap/bootstrap.min.js'></script>
	</body>
</html>