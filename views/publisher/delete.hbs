<div class='mb-5'>
	<div class='card shadow-sm border-0'>
		<div class='card-header bg-dark text-white'>
			<h2 class='fs-5 m-0'>
				<i class='bi bi-trash3'></i>
				Delete publisher
			</h2>
		</div>

		<div class='card-body text-center py-5'>
			{{#if hasBooks}}
				<p class='fs-5 mt-3 mb-2'>
					The publisher
					<strong>{{publisher.name}}</strong>
					cannot be deleted.
				</p>
				<p class='text-secondary mb-4'>
					It has
					{{booksCount}}
					associated
					{{#if (eq booksCount 1)}}book{{else}}books{{/if}}. Delete or reassign
					them first.
				</p>

				<a href='/publishers/index' class='btn btn-outline-dark px-4'>
					<i class='bi bi-arrow-left'></i>
					Go back
				</a>
			{{else}}
				<form method='post' action='/publishers/delete'>
					<input type='hidden' name='id' value='{{publisher.id}}' />

					<p class='fs-5 mt-3 mb-4'>
						Are you sure you want to delete the publisher
						<strong>{{publisher.name}}</strong>?
					</p>

					<div class='d-flex justify-content-center gap-2'>
						<a href='/publishers/index' class='btn btn-outline-dark px-4'>
							<i class='bi bi-x-lg'></i>
							Cancel
						</a>

						<button type='submit' class='btn btn-danger px-4'>
							<i class='bi bi-trash3'></i>
							Accept
						</button>
					</div>
				</form>
			{{/if}}
		</div>
	</div>
</div>